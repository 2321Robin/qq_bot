DRIVER=~fastapi
HOST=127.0.0.1
PORT=8081
COMMAND_START=["/"]
SUPERUSERS=[]

ALLOWED_GROUP_IDS=
ADMIN_USER_IDS=

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PREFIX=ai
# 忽略的用户 ID 列表（逗号分隔）：这些用户触发的 AI 对话不调用模型
AI_IGNORED_USER_IDS=
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_FALLBACK_MODEL=glm-4-flash
CHAT_MEMORY_PATH=data/chat_memory.sqlite3
CHAT_MEMORY_RETENTION_DAYS=3
CHAT_MEMORY_DEFAULT_TURNS=10
CHAT_MEMORY_MAX_RESULTS=20
SEARCH_ENABLED=false
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10

# 洛克王国功能总开关（精灵/技能查询、AI 本地知识增强、Agent 图鉴工具）。
# 置 false 时以上功能全部停用，代码与本地数据保留。
ROCO_ENABLED=true

SCHEDULED_GROUP_IDS=
SCHEDULED_MESSAGE=现在是定时提醒时间。
SCHEDULED_CRON_TIMES=
SCHEDULED_CRON_HOUR=9
SCHEDULED_CRON_MINUTE=0

# 泛化定时任务表（type@HH:MM 逗号分隔）。非空时取代 SCHEDULED_CRON_TIMES。
# 类型：static=固定文本 | life_morning/life_evening=生活早/晚报（Stage D）
#      | game_morning/game_evening=游戏早/晚报（Stage C）
#SCHEDULED_JOBS=life_morning@07:30,game_morning@07:30,life_evening@22:00,game_evening@22:00
SCHEDULED_JOBS=
# 倒计时事件（名称:YYYY-MM-DD 逗号分隔）；过期自动隐藏，出现在生活早/晚报
#COUNTDOWN_EVENTS=六级考试:2026-12-12
COUNTDOWN_EVENTS=
# 游戏日历（路线 1：人/agent 手工维护）。复制模板
# tests/fixtures/game_reports/game_calendar.template.json 到 data/game_calendar.json
# 后按需增删活动；文件为私有数据不入库。注册 game_* 任务时加载并校验，
# 非法文件拒绝启动；修改后需重启生效。
GAME_CALENDAR_PATH=data/game_calendar.json

# 命名提及替换："@昵称=QQ号,@昵称2=QQ号2"（仅接受整数 QQ 号，
# 避免把真实账号写进代码仓库）。发送的定时消息与 AI 回复中的
# @昵称 会替换为真正的 @提及。
NAMED_MENTION_REPLACEMENTS=

# 可靠性（重试 + 熔断）。attempts 含首次调用；延迟为带抖动上限的指数退避；
# 熔断器只统计瞬时依赖故障，恢复窗口后自动半开探测。
AI_MAX_ATTEMPTS=2
AI_RETRY_BASE_DELAY_SECONDS=0.5
AI_RETRY_MAX_DELAY_SECONDS=4.0
SEARCH_MAX_ATTEMPTS=3
SEARCH_RETRY_BASE_DELAY_SECONDS=0.5
SEARCH_RETRY_MAX_DELAY_SECONDS=4.0
SEND_MAX_ATTEMPTS=2
SEND_RETRY_BASE_DELAY_SECONDS=0.5
SEND_RETRY_MAX_DELAY_SECONDS=3.0
RETRY_JITTER_RATIO=0.1
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_SECONDS=30.0

# Agent（阶段 2 Tool Calling）。AGENT_ENABLED=false 时保持阶段 1 旧链路；
# 阶段 2 验收在 Agent 模式执行。AI_ROUTER_MODEL 留空时复用 AI_MODEL。
# 评测：scripts/run_agent_eval.py --mode live 需显式 AGENT_EVAL_LIVE=1 + 真实
# Provider 配置；无 Provider 时拒绝运行，绝不伪造结果。
AGENT_ENABLED=false
AI_ROUTER_MODEL=
AI_ROUTER_CONFIDENCE_THRESHOLD=0.75
AGENT_MAX_ROUNDS=3
AGENT_MAX_TOOL_CALLS=4
AGENT_TOOLS_PER_ROUND=2
AGENT_DEADLINE_SECONDS=60
AI_PROVIDER_TOOLS_ENABLED=true
AI_PROVIDER_STRUCTURED_OUTPUT_ENABLED=true
# 语义 verifier（正式评测必须开启）；确定性 grounding 检查始终运行、不可关闭。
AI_SEMANTIC_VERIFIER_ENABLED=false
AI_VERIFIER_MODEL=

# Token 预算（S2-TOKEN-01..08）：context window 必须大于 output reserve + safety margin；
# 各来源 ratio 非负且总和不超过 1；未使用配额让给高优先来源。
AI_CONTEXT_WINDOW_TOKENS=128000
AI_OUTPUT_RESERVE_TOKENS=2048
AI_TOKEN_SAFETY_MARGIN=1024
AGENT_BUDGET_LOCAL_RATIO=0.30
AGENT_BUDGET_WEB_RATIO=0.25
AGENT_BUDGET_RECENT_RATIO=0.15
AGENT_BUDGET_SUMMARY_RATIO=0.10
AGENT_BUDGET_PREFERENCE_MAX_TOKENS=256

# 分层记忆（S2-MEM-05..09）：短期摘要默认关闭（开启后仅摘要过期消息，
# 不延长保留期）；长期偏好仅通过显式命令 /记忆保存 写入，超出
# MEMORY_PREFERENCE_MAX_CHARS 字符的部分会被截断。
MEMORY_SUMMARY_ENABLED=false
MEMORY_PREFERENCE_MAX_CHARS=200

# 数据管道（阶段 3）：质量门禁默认阈值取自 2026-08-02 实测基线并留出裕量；
# 硬门禁失败会阻断发布，放行必须显式（--allow-quarantine）且写入差异报告。
# 搜索索引缺失/损坏时运行时自动回退全量遍历，不影响查询。
DATA_MIN_RECORDS=500
DATA_MAX_RECORD_DROP=30
DATA_MAX_NEW_NUMBER_GAPS=0
DATA_MIN_STATS_COMPLETE_RATE=0.80
DATA_MIN_TOTAL_RACE_RATE=0.95
DATA_MAX_DANGLING_EDGES=0
DATA_MAX_SKILL_KEY_MISSING_RATE=0.005
DATA_SEARCH_INDEX_PATH=data/roco_search.sqlite3
DATA_USE_SEARCH_INDEX=true

# 可观测性（阶段 4）：LOG_FORMAT=json 时输出单行 JSON（字段白名单）；
# 日志/指标/span 只出现哈希群/用户号与聚合，不记录正文/prompt/API Key。
# /metrics 与 /healthz、/readyz 同端口（8081），外部 Prometheus 按需抓取，
# 仓库不内置采集服务；METRICS_ENABLED=false 时 /metrics 404 且埋点零开销。
LOG_FORMAT=text
LOG_LEVEL=INFO
METRICS_ENABLED=true
TRACE_ENABLED=true
READYZ_REQUIRE_ONEBOT=false
READYZ_REQUIRE_DATA=true

# 配额与费用预算（阶段 4）：入口层准入，与阶段 2 单请求执行预算互补。
# 0 = 关闭对应项；只有 actual 成本计入强制上限，estimated/unknown 只记录。
QUOTA_ENABLED=true
QUOTA_RATE_LIMIT_PER_MINUTE=30
QUOTA_DAILY_COST_LIMIT_USD=2.0
QUOTA_GROUP_DAILY_COST_LIMIT_USD=0.5

# 生活早晚报（阶段 D）：SCHEDULED_JOBS 配 life_morning/life_evening 后生效。
# 数据源为自部署 60s fork（含 /news /hot /heh 三个适配端点，契约见
# docs/superpowers/plans/2026-09-15-stage-d-life-reports.md）；板块级独立降级，
# 任一来源失败显示占位符，整报照发。
REPORT_60S_BASE_URL=
REPORT_60S_TIMEOUT_SECONDS=10
REPORT_HOTLIST_MAX_ITEMS=5
# 新闻板块条数与标题屏蔽词（逗号分隔，标题含任一词即剔除该条）
REPORT_NEWS_MAX_ITEMS=10
REPORT_NEWS_BLOCKLIST=
# 晚报新闻源：toutiao=头条热榜（默认，避免与早报 60s 新闻重复）| news=与早报同源
REPORT_EVENING_NEWS_ENDPOINT=toutiao
# 新闻 LLM 润色 + 寄语：复用主备模型链路；确定性校验失败自动回退模板；
# 独立每日次数上限（0 = 关闭润色），调用计入 quota_usage 的 report scope。
REPORT_AI_ENABLED=false
REPORT_AI_MODEL=
REPORT_AI_DAILY_MAX=20

# 自主群聊插话（S7-AUTO）：非 @ 消息经 规则预筛→采样→LLM决策门→群友模式生成
# 自主决定是否插话。默认关闭；开启后仍受 QUOTA_* 费用上限约束。
AUTO_CHAT_ENABLED=false
# 人设：昵称同时用于"点名"匹配；PERSONA_PROMPT 留空用内置默认风格。
PERSONA_NAME=
PERSONA_ALIASES=
PERSONA_PROMPT=
# 采样率：预筛通过的消息进入 LLM 决策门的比例；冷却/上限为每群独立计数。
AUTO_CHAT_SAMPLE_RATE=0.2
AUTO_CHAT_COOLDOWN_SECONDS=300
AUTO_CHAT_HOURLY_LIMIT=6
AUTO_CHAT_DAILY_LIMIT=30
AUTO_CHAT_CONFIDENCE_THRESHOLD=0.7
AUTO_CHAT_DELAY_MIN_SECONDS=1
AUTO_CHAT_DELAY_MAX_SECONDS=3
AUTO_CHAT_NEGATIVE_BACKOFF_SECONDS=1800
# 词表为逗号分隔的追加项，与内置表合并（内置表覆盖赌博/色情/毒品/暴力等）。
AUTO_CHAT_SENSITIVE_WORDS=
AUTO_CHAT_NEGATIVE_WORDS=
# 自主插话忽略的发送者 QQ（逗号分隔），可填其他机器人号避免互答。
AUTO_CHAT_IGNORED_USER_IDS=
AUTO_CHAT_CONTEXT_MESSAGES=10
